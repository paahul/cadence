# Copy this file to .env.local and fill in the values.
# Do NOT commit .env.local — it's gitignored.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Resend — for the daily digest email (M4)
# Get key from https://resend.com/api-keys
RESEND_API_KEY=re_...

# From-address for the daily digest. Use the "Name <email>" format. Must use a verified
# Resend domain to deliver to anyone besides the Resend account owner.
# If unset, falls back to "Cadence <onboarding@resend.dev>" — testing only.
CADENCE_DIGEST_FROM_ADDRESS=Cadence <coach@yourdomain.com>

# Random secret used to authenticate Vercel Cron requests to /api/cron/*.
# Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string

# Inngest — background job runner for the analysis queue (M7).
# Both keys come from the Inngest dashboard after creating an app.
# When unset, /api/analyze falls back to synchronous mode (subject to
# Vercel's 60s function timeout and the client-side 2-min recording cap).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

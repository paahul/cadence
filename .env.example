# Copy this file to .env.local and fill in the values.
# Do NOT commit .env.local — it's gitignored.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Resend — for the daily digest email (M4)
# Get key from https://resend.com/api-keys
# For single-user mode, the from-address is hardcoded to onboarding@resend.dev
# and the digest can only be delivered to the email registered on your Resend account.
RESEND_API_KEY=re_...

# Where to deliver the daily digest. Must match the email registered on your Resend account
# (because we send from onboarding@resend.dev — see M8 to fix this once you invite friends).
CADENCE_DIGEST_RECIPIENT=you@example.com

# Random secret used to authenticate Vercel Cron requests to /api/cron/*.
# Generate with: openssl rand -base64 32
CRON_SECRET=replace-with-a-long-random-string
